digraph parcours {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.48", fontname="DejaVu Sans", fontsize=20, labelloc=t, label="1. De make krpsim à la trace"];
node [shape=box, style="rounded,filled", fillcolor="#EEF4FB", color="#56718C", fontname="DejaVu Sans", fontsize=12, margin="0.18,0.12"];
edge [color="#61758A", fontname="DejaVu Sans", fontsize=11, arrowsize=0.7];
start [label="make krpsim fichier_ressource limite", shape=box, fillcolor="#EEF4FB"];
uv [label="uv exécutable ?\nMakefile : install", shape=diamond, fillcolor="#FFF1CF"];
getUv [label="Installer uv sans modifier le PATH", shape=box, fillcolor="#EEF4FB"];
env [label="Python de .venv sélectionné par uv ?\nInterpréteur présent et compatible", shape=diamond, fillcolor="#FFF1CF"];
repair [label="Créer ou réparer sans effacer\nuv venv --allow-existing", shape=box, fillcolor="#EEF4FB"];
sync [label="Synchroniser les dépendances\nuv sync --locked", shape=box, fillcolor="#EEF4FB"];
exec [label="Exécuter .venv/bin/krpsim\nARGS + --trace trace_NOM.txt", shape=box, fillcolor="#EEF4FB"];
cli [label="Entrée Python : cli.py · main\npyproject.toml : krpsim.cli:main", shape=box, fillcolor="#EEF4FB"];
args [label="Arguments et chemin valides ?\nbuild_parser · _validate_args", shape=diamond, fillcolor="#FFF1CF"];
errArgs [label="Diagnostic argparse · code 2", shape=box, fillcolor="#FDE4E1"];
parse [label="Lire et valider la configuration\nparser.py · parse_file — détail 2", shape=box, fillcolor="#EEF4FB"];
valid [label="Configuration valide ?", shape=diamond, fillcolor="#FFF1CF"];
errConfig [label="invalid config · code 1\n_run_checked_simulation", shape=box, fillcolor="#FDE4E1"];
timeMode [label="Premier critère = time ?", shape=diamond, fillcolor="#FFF1CF"];
boundTime [label="Limite interne = 100000\nignore_delay = True", shape=box, fillcolor="#EEF4FB"];
boundArg [label="Limite interne = delay demandé", shape=box, fillcolor="#EEF4FB"];
run [label="Simuler et choisir les processus\nsimulator.py · run — détails 3 à 5", shape=box, fillcolor="#EEF4FB"];
write [label="Afficher puis enregistrer la trace\ndisplay.py · save_trace", shape=box, fillcolor="#EEF4FB"];
status [label="Déterminer le code de sortie\ncli.py · _exit_code_for_simulation — détail 6", shape=box, fillcolor="#EEF4FB"];
finish [label="Afficher les stocks finaux\nmain retourne le code à Make", shape=box, fillcolor="#DEF3E5"];
start -> uv [label=""];
uv -> getUv [label="Non"];
uv -> env [label="Oui"];
getUv -> env [label="Installation réussie"];
env -> repair [label="Non"];
env -> sync [label="Oui"];
repair -> sync [label="Réparation réussie"];
sync -> exec [label="Succès"];
exec -> cli [label=""];
cli -> args [label=""];
args -> errArgs [label="Non"];
args -> parse [label="Oui"];
parse -> valid [label=""];
valid -> errConfig [label="Non : ParseError"];
valid -> timeMode [label="Oui"];
timeMode -> boundTime [label="Oui"];
timeMode -> boundArg [label="Non"];
boundTime -> run [label=""];
boundArg -> run [label=""];
run -> write [label="Retour normal"];
write -> status [label="Écriture réussie"];
status -> finish [label=""];
}
