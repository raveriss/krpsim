digraph parcours {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.48", fontname="DejaVu Sans", fontsize=20, labelloc=t, label="3. simulator.py : choisir la voie et avancer"];
node [shape=box, style="rounded,filled", fillcolor="#EEF4FB", color="#56718C", fontname="DejaVu Sans", fontsize=12, margin="0.18,0.12"];
edge [color="#61758A", fontname="DejaVu Sans", fontsize=11, arrowsize=0.7];
init [label="Initialiser le simulateur\n__init__ : copie des stocks, temps 0", shape=box, fillcolor="#EEF4FB"];
custom [label="Stratégie spécialisée applicable ?\n_custom_strategy", shape=diamond, fillcolor="#FFF1CF"];
apply [label="Calculer puis appliquer le plan spécialisé\n_best_loops → _apply_custom_plan", shape=box, fillcolor="#EEF4FB"];
bound [label="Temps courant ≤ limite interne ?\nrun", shape=diamond, fillcolor="#FFF1CF"];
complete [label="Terminer les processus arrivés à échéance\nstep → _complete_running", shape=box, fillcolor="#EEF4FB"];
objective [label="Un objectif de production existe ?\nProductionPlanner.enabled", shape=diamond, fillcolor="#FFF1CF"];
planned [label="Démarrer selon le plan ou le repli\n_start_objective_processes — détail 4", shape=box, fillcolor="#EEF4FB"];
exhaustive [label="Parcourir les processus triés\n_start_exhaustive_processes → order_processes", shape=box, fillcolor="#EEF4FB"];
advance [label="Processus en cours ou\ndémarrage de durée positive ?", shape=diamond, fillcolor="#FFF1CF"];
tick [label="Temps courant += 1\nstep retourne True", shape=box, fillcolor="#EEF4FB"];
noTrace [label="Trace vide avec processus définis ?", shape=diamond, fillcolor="#FFF1CF"];
improve [label="Planificateur actif ET\nau moins un processus lançable ?", shape=diamond, fillcolor="#FFF1CF"];
noImprove [label="no_improvement = True\nAucune amélioration trouvée", shape=box, fillcolor="#EEF4FB"];
deadlock [label="deadlock = True\nAucun démarrage enregistré", shape=box, fillcolor="#EEF4FB"];
done [label="Retourner la trace à cli.py", shape=box, fillcolor="#DEF3E5"];
init -> custom [label=""];
custom -> apply [label="Oui"];
apply -> done [label=""];
custom -> bound [label="Non"];
bound -> complete [label="Oui"];
bound -> noTrace [label="Non"];
complete -> objective [label=""];
objective -> planned [label="Oui"];
objective -> exhaustive [label="Non"];
planned -> advance [label=""];
exhaustive -> advance [label=""];
advance -> tick [label="Oui"];
tick -> bound [label=""];
advance -> noTrace [label="Non"];
noTrace -> done [label="Non"];
noTrace -> improve [label="Oui"];
improve -> noImprove [label="Oui"];
improve -> deadlock [label="Non"];
noImprove -> done [label=""];
deadlock -> done [label=""];
}
