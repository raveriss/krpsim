digraph parcours {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.48", fontname="DejaVu Sans", fontsize=20, labelloc=t, label="4. optimizer.py et partial.py : préparer les démarrages"];
node [shape=box, style="rounded,filled", fillcolor="#EEF4FB", color="#56718C", fontname="DejaVu Sans", fontsize=12, margin="0.18,0.12"];
edge [color="#61758A", fontname="DejaVu Sans", fontsize=11, arrowsize=0.7];
entry [label="Préparer le plan du cycle\n_prepare_objective_plan", shape=box, fillcolor="#EEF4FB"];
pending [label="Plan restant ou processus en cours ?", shape=diamond, fillcolor="#FFF1CF"];
finished [label="Limite atteinte ou planification terminée ?", shape=diamond, fillcolor="#FFF1CF"];
partialExists [label="Repli partiel déjà créé ?", shape=diamond, fillcolor="#FFF1CF"];
search [label="Chercher un lot sur des stocks copiés\nProductionPlanner.search_batch → build_batch", shape=box, fillcolor="#EEF4FB"];
found [label="Plan complet trouvé ?", shape=diamond, fillcolor="#FFF1CF"];
store [label="Copier les quantités prévues\n_plan_counts = plan.counts.copy()", shape=box, fillcolor="#EEF4FB"];
launch [label="Lancer les occurrences possibles\n_launch_planned_processes → _launch", shape=box, fillcolor="#EEF4FB"];
stalled [label="Aucun lancement, aucun travail en cours,\nmais occurrences prévues restantes ?", shape=diamond, fillcolor="#FFF1CF"];
abandon [label="Vider le plan bloqué\n_planning_finished = True", shape=box, fillcolor="#EEF4FB"];
fallback [label="Créer le planificateur partiel\nPartialPlanner : objectifs et catalyseurs protégés", shape=box, fillcolor="#EEF4FB"];
partial [label="Choisir un processus faisable\nnext_process → _eligible → _priority", shape=box, fillcolor="#EEF4FB"];
partialLaunch [label="Exécuter le repli disponible\n_start_partial_processes → _launch", shape=box, fillcolor="#EEF4FB"];
terminal [label="Tenter le convertisseur final\n_launch_terminal", shape=box, fillcolor="#EEF4FB"];
return [label="Retourner les indicateurs de démarrage\nVers step : détail 3", shape=box, fillcolor="#DEF3E5"];
entry -> pending [label=""];
pending -> launch [label="Oui"];
pending -> finished [label="Non"];
finished -> terminal [label="Oui"];
finished -> partialExists [label="Non"];
partialExists -> partial [label="Oui"];
partialExists -> search [label="Non"];
search -> found [label=""];
found -> store [label="Oui"];
store -> launch [label=""];
found -> fallback [label="Non"];
fallback -> partial [label=""];
partial -> partialLaunch [label=""];
partialLaunch -> return [label=""];
launch -> stalled [label=""];
stalled -> abandon [label="Oui"];
abandon -> terminal [label=""];
stalled -> return [label="Non"];
terminal -> return [label=""];
}
