digraph parcours {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.48", fontname="DejaVu Sans", fontsize=20, labelloc=t, label="2. parser.py : construire une configuration"];
node [shape=box, style="rounded,filled", fillcolor="#EEF4FB", color="#56718C", fontname="DejaVu Sans", fontsize=12, margin="0.18,0.12"];
edge [color="#61758A", fontname="DejaVu Sans", fontsize=11, arrowsize=0.7];
read [label="Lire le fichier\nparse_file → _read_lines", shape=box, fillcolor="#EEF4FB"];
encoding [label="UTF-8 sans BOM, sans CR\net lignes de 255 caractères maximum ?", shape=diamond, fillcolor="#FFF1CF"];
line [label="Lire la ligne suivante\n_parse_lines", shape=box, fillcolor="#EEF4FB"];
more [label="Une ligne reste à analyser ?", shape=diamond, fillcolor="#FFF1CF"];
empty [label="Ligne vide ou commentaire ?", shape=diamond, fillcolor="#FFF1CF"];
opt [label="Commence par optimize: ?", shape=diamond, fillcolor="#FFF1CF"];
process [label="Contient :( ?", shape=diamond, fillcolor="#FFF1CF"];
stock [label="Contient : ?", shape=diamond, fillcolor="#FFF1CF"];
handleOpt [label="Lire les objectifs\n_handle_optimize → _parse_optimize", shape=box, fillcolor="#EEF4FB"];
handleProcess [label="Lire le processus et ses ressources\n_handle_process → _parse_process → _parse_resources", shape=box, fillcolor="#EEF4FB"];
handleStock [label="Lire le stock initial\n_handle_stock → _parse_stock", shape=box, fillcolor="#EEF4FB"];
check [label="Au moins un stock et un processus ;\nobjectifs et ressources connus ?", shape=diamond, fillcolor="#FFF1CF"];
config [label="Retourner Config\nstocks, processes, optimize", shape=box, fillcolor="#DEF3E5"];
error [label="Lever ParseError\nLa CLI affiche invalid config et retourne 1", shape=box, fillcolor="#FDE4E1"];
read -> encoding [label=""];
encoding -> error [label="Non"];
encoding -> more [label="Oui"];
more -> line [label="Oui"];
more -> check [label="Non"];
line -> empty [label=""];
empty -> more [label="Oui"];
empty -> opt [label="Non"];
opt -> handleOpt [label="Oui"];
opt -> process [label="Non"];
process -> handleProcess [label="Oui"];
process -> stock [label="Non"];
stock -> handleStock [label="Oui"];
stock -> error [label="Non"];
handleOpt -> more [label="Valide"];
handleProcess -> more [label="Valide"];
handleStock -> more [label="Valide"];
handleOpt -> error [label="Invalide / doublon"];
handleProcess -> error [label="Invalide / doublon"];
handleStock -> error [label="Invalide / doublon"];
check -> config [label="Oui"];
check -> error [label="Non"];
}
