digraph flow {
graph [rankdir=TB, ranksep=0.28, nodesep=0.25, pad=0.12, splines=polyline, bgcolor="transparent", ordering=out];
node [fontname="Inter", fontsize=13, color="#66869b", fontcolor="#172e43", penwidth=1.1, margin="0.13,0.09"];
edge [fontname="Inter", fontsize=11, color="#486d84", fontcolor="#235d6d", penwidth=1.15, arrowsize=0.7];
start [shape=ellipse, style="filled", fillcolor="#e2f2e7", peripheries=1, label=<<FONT POINT-SIZE="13">Directive reconnue ; recevoir son bloc</FONT>>];
init [shape=box, style="filled,rounded", fillcolor="#edf4fa", peripheries=1, label=<<FONT POINT-SIZE="13">Extraire le bloc ; préparer une liste vide</FONT><BR/><FONT POINT-SIZE="10.5">block = match.group(1)<BR/>items = [] (forme développée)</FONT>>];
more [shape=diamond, style="filled", fillcolor="#fff3cd", peripheries=1, label=<<FONT POINT-SIZE="13">Reste-t-il un élément entre les « ;<BR/>» ?</FONT><BR/><FONT POINT-SIZE="10.5">for item in block.split(&quot;;&quot;)</FONT>>];
D40 [shape=diamond, style="filled", fillcolor="#fff3cd", peripheries=1, label=<<FONT POINT-SIZE="13">D40 · Cet élément contient-il du<BR/>texte ?</FONT><BR/><FONT POINT-SIZE="10.5">[item for item in block.split(&quot;;&quot;) if item]</FONT>>];
keep [shape=box, style="filled,rounded", fillcolor="#edf4fa", peripheries=1, label=<<FONT POINT-SIZE="13">Conserver cet élément</FONT><BR/><FONT POINT-SIZE="10.5">items.append(item)</FONT>>];
D41 [shape=diamond, style="filled", fillcolor="#fff3cd", peripheries=1, label=<<FONT POINT-SIZE="13">D41 · La liste conservée est-elle<BR/>vide ?</FONT><BR/><FONT POINT-SIZE="10.5">not items</FONT>>];
end [shape=ellipse, style="filled", fillcolor="#e2f2e7", peripheries=1, label=<<FONT POINT-SIZE="13">Revenir dans G20 avec items</FONT><BR/><FONT POINT-SIZE="10.5">Liste non vide</FONT>>];
error [shape=ellipse, style="filled", fillcolor="#fbe7e2", peripheries=1, label=<<FONT POINT-SIZE="13">Refuser la directive</FONT><BR/><FONT POINT-SIZE="10.5">ParseError → G02<BR/>duplicate / invalid optimize line</FONT>>];
start -> init [label=""];
init -> more [label=""];
more -> D40 [label="Oui"];
more -> D41 [label="Non"];
D40 -> keep [label="Oui"];
D40 -> more [xlabel="Non", constraint=false, tailport=w, headport=w];
keep -> more [xlabel="Élément suivant", constraint=false];
D41 -> error [label="Oui"];
D41 -> end [label="Non"];
}