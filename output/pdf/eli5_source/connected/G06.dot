digraph flow {
graph [rankdir=TB, ranksep=0.28, nodesep=0.25, pad=0.12, splines=polyline, bgcolor="transparent", ordering=out];
node [fontname="Inter", fontsize=13, color="#66869b", fontcolor="#172e43", penwidth=1.1, margin="0.13,0.09"];
edge [fontname="Inter", fontsize=11, color="#486d84", fontcolor="#235d6d", penwidth=1.15, arrowsize=0.7];
start [shape=ellipse, style="filled", fillcolor="#e2f2e7", peripheries=1, label=<<FONT POINT-SIZE="13">Recevoir config et trace</FONT>>];
D06 [shape=diamond, style="filled", fillcolor="#fff3cd", peripheries=1, label=<<FONT POINT-SIZE="13">D06 · La liste des départs est-elle<BR/>vide ?</FONT><BR/><FONT POINT-SIZE="10.5">not trace</FONT>>];
empty [shape=box, style="filled,rounded", fillcolor="#e3f1f3", peripheries=2, label=<<FONT POINT-SIZE="13">Appliquer la règle spéciale de trace vide<BR/>Détail : G07</FONT><BR/><FONT POINT-SIZE="10.5">_verify_empty_trace(config)</FONT>>];
init [shape=box, style="filled,rounded", fillcolor="#edf4fa", peripheries=1, label=<<FONT POINT-SIZE="13">Copier les stocks et vider les opérations<BR/>en cours</FONT><BR/><FONT POINT-SIZE="10.5">state =<BR/>_VerificationState(config.stocks.copy(), [])</FONT>>];
D15 [shape=diamond, style="filled", fillcolor="#fff3cd", peripheries=1, label=<<FONT POINT-SIZE="13">D15 · Reste-t-il un départ à<BR/>vérifier ?</FONT><BR/><FONT POINT-SIZE="10.5">for line_number, entry in enumerate(trace,<BR/>start=1)</FONT>>];
entry [shape=box, style="filled,rounded", fillcolor="#e3f1f3", peripheries=2, label=<<FONT POINT-SIZE="13">Vérifier et appliquer ce départ<BR/>Détail : G08</FONT><BR/><FONT POINT-SIZE="10.5">_verify_entry(config, entry, line_number,<BR/>state)</FONT>>];
finish [shape=box, style="filled,rounded", fillcolor="#e3f1f3", peripheries=2, label=<<FONT POINT-SIZE="13">Finaliser les productions et construire le<BR/>résultat<BR/>Détail : G11</FONT><BR/><FONT POINT-SIZE="10.5">_build_verified_simulator(config, state)</FONT>>];
end [shape=ellipse, style="filled", fillcolor="#e2f2e7", peripheries=1, label=<<FONT POINT-SIZE="13">Renvoyer sim à G03</FONT><BR/><FONT POINT-SIZE="10.5">return sim</FONT>>];
error [shape=ellipse, style="filled", fillcolor="#fbe7e2", peripheries=1, label=<<FONT POINT-SIZE="13">Arrêter au premier échec ; remonter à G02</FONT><BR/><FONT POINT-SIZE="10.5">TraceError ou exception inattendue</FONT>>];
start -> D06 [label=""];
D06 -> empty [label="Oui"];
D06 -> init [label="Non"];
empty -> end [label="Acceptée"];
empty -> error [label="Erreur"];
init -> D15 [label=""];
D15 -> entry [label="Oui"];
D15 -> finish [label="Non"];
entry -> D15 [xlabel="Départ suivant", constraint=false, tailport=w, headport=w];
entry -> error [label="Erreur"];
finish -> end [label="Retour normal"];
}