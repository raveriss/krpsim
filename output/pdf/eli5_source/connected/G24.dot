digraph flow {
graph [rankdir=TB, ranksep=0.28, nodesep=0.25, pad=0.12, splines=polyline, bgcolor="transparent", ordering=out];
node [fontname="Inter", fontsize=13, color="#66869b", fontcolor="#172e43", penwidth=1.1, margin="0.13,0.09"];
edge [fontname="Inter", fontsize=11, color="#486d84", fontcolor="#235d6d", penwidth=1.15, arrowsize=0.7];
start [shape=ellipse, style="filled", fillcolor="#e2f2e7", peripheries=1, label=<<FONT POINT-SIZE="13">Construire Simulator(config)</FONT>>];
copy [shape=box, style="filled,rounded", fillcolor="#edf4fa", peripheries=1, label=<<FONT POINT-SIZE="13">Conserver la configuration et copier ses<BR/>stocks</FONT><BR/><FONT POINT-SIZE="10.5">self.config = config<BR/>self.stocks = config.stocks.copy()</FONT>>];
init [shape=box, style="filled,rounded", fillcolor="#edf4fa", peripheries=1, label=<<FONT POINT-SIZE="13">Initialiser le temps, les listes et les<BR/>indicateurs</FONT><BR/><FONT POINT-SIZE="10.5">self.time = self._max_time = 0<BR/>self._running = []; self.trace = []</FONT>>];
planner [shape=box, style="filled,rounded", fillcolor="#e3f1f3", peripheries=2, label=<<FONT POINT-SIZE="13">Préparer les informations du planificateur<BR/>Détail : G25</FONT><BR/><FONT POINT-SIZE="10.5">self._planner = ProductionPlanner(config)</FONT>>];
plan [shape=box, style="filled,rounded", fillcolor="#edf4fa", peripheries=1, label=<<FONT POINT-SIZE="13">Préparer les comptes du plan, sans le<BR/>rechercher</FONT><BR/><FONT POINT-SIZE="10.5">self._plan_counts = {}<BR/>self._planning_finished = False</FONT>>];
end [shape=ellipse, style="filled", fillcolor="#e2f2e7", peripheries=1, label=<<FONT POINT-SIZE="13">Objet construit ; revenir à G07 ou G11</FONT>>];
start -> copy [label=""];
copy -> init [label=""];
init -> planner [label=""];
planner -> plan [label=""];
plan -> end [label=""];
}