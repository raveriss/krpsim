digraph flow {
graph [rankdir=TB, ranksep=0.28, nodesep=0.25, pad=0.12, splines=polyline, bgcolor="transparent", ordering=out];
node [fontname="Inter", fontsize=13, color="#66869b", fontcolor="#172e43", penwidth=1.1, margin="0.13,0.09"];
edge [fontname="Inter", fontsize=11, color="#486d84", fontcolor="#235d6d", penwidth=1.15, arrowsize=0.7];
start [shape=ellipse, style="filled", fillcolor="#e2f2e7", peripheries=1, label=<<FONT POINT-SIZE="13">Recevoir le chemin de configuration</FONT>>];
path [shape=box, style="filled,rounded", fillcolor="#e3f1f3", peripheries=2, label=<<FONT POINT-SIZE="13">Contrôler le chemin et les droits<BR/>Détail : G14</FONT><BR/><FONT POINT-SIZE="10.5">Début de parse_file(path)</FONT>>];
read [shape=box, style="filled,rounded", fillcolor="#e3f1f3", peripheries=2, label=<<FONT POINT-SIZE="13">Lire les octets, décoder et vérifier les<BR/>lignes<BR/>Détail : G15</FONT><BR/><FONT POINT-SIZE="10.5">lines = _read_lines(path)</FONT>>];
parse [shape=box, style="filled,rounded", fillcolor="#e3f1f3", peripheries=2, label=<<FONT POINT-SIZE="13">Lire stocks, opérations et objectifs<BR/>Détail : G16</FONT><BR/><FONT POINT-SIZE="10.5">stocks, processes, optimize =<BR/>_parse_lines(lines)</FONT>>];
D43 [shape=diamond, style="filled", fillcolor="#fff3cd", peripheries=1, label=<<FONT POINT-SIZE="13">D43 · Manque-t-il tout stock initial<BR/>ou toute opération ?</FONT><BR/><FONT POINT-SIZE="10.5">not stocks or not processes</FONT>>];
D44 [shape=diamond, style="filled", fillcolor="#fff3cd", peripheries=1, label=<<FONT POINT-SIZE="13">D44 · Une liste d’objectifs non vide<BR/>est-elle présente ?</FONT><BR/><FONT POINT-SIZE="10.5">if optimize</FONT>>];
goals [shape=box, style="filled,rounded", fillcolor="#e3f1f3", peripheries=2, label=<<FONT POINT-SIZE="13">Vérifier que les objectifs sont connus<BR/>Détail : G22</FONT><BR/><FONT POINT-SIZE="10.5">_validate_optimize(optimize, stocks,<BR/>processes)</FONT>>];
needs [shape=box, style="filled,rounded", fillcolor="#e3f1f3", peripheries=2, label=<<FONT POINT-SIZE="13">Vérifier l’existence des ressources<BR/>nécessaires<BR/>Détail : G23</FONT><BR/><FONT POINT-SIZE="10.5">_validate_process_resources(stocks, processes)</FONT>>];
end [shape=ellipse, style="filled", fillcolor="#e2f2e7", peripheries=1, label=<<FONT POINT-SIZE="13">Renvoyer Config à G03</FONT><BR/><FONT POINT-SIZE="10.5">return Config(stocks, processes, optimize)</FONT>>];
error [shape=ellipse, style="filled", fillcolor="#fbe7e2", peripheries=1, label=<<FONT POINT-SIZE="13">Refuser : configuration incomplète</FONT><BR/><FONT POINT-SIZE="10.5">ParseError → G02</FONT>>];
start -> path [label=""];
path -> read [label=""];
read -> parse [label=""];
parse -> D43 [label=""];
D43 -> error [label="Oui"];
D43 -> D44 [label="Non"];
D44 -> goals [label="Oui"];
D44 -> needs [label="Non"];
goals -> needs [label=""];
needs -> end [label=""];
}