digraph flow {
graph [rankdir=TB, ranksep=0.28, nodesep=0.25, pad=0.12, splines=polyline, bgcolor="transparent", ordering=out];
node [fontname="Inter", fontsize=13, color="#66869b", fontcolor="#172e43", penwidth=1.1, margin="0.13,0.09"];
edge [fontname="Inter", fontsize=11, color="#486d84", fontcolor="#235d6d", penwidth=1.15, arrowsize=0.7];
start [shape=ellipse, style="filled", fillcolor="#e2f2e7", peripheries=1, label=<<FONT POINT-SIZE="13">Entrer dans la fonction</FONT>>];
init [shape=box, style="filled,rounded", fillcolor="#edf4fa", peripheries=1, label=<<FONT POINT-SIZE="13">Partir des noms de stocks initiaux</FONT><BR/><FONT POINT-SIZE="10.5">defined = set(stocks)</FONT>>];
producers [shape=diamond, style="filled", fillcolor="#fff3cd", peripheries=1, label=<<FONT POINT-SIZE="13">Reste-t-il une opération dont on<BR/>doit lire les résultats ?</FONT><BR/><FONT POINT-SIZE="10.5">for proc in processes.values()</FONT>>];
gather [shape=box, style="filled,rounded", fillcolor="#edf4fa", peripheries=1, label=<<FONT POINT-SIZE="13">Ajouter les ressources qu’elle peut<BR/>produire</FONT><BR/><FONT POINT-SIZE="10.5">defined.update(proc.results)</FONT>>];
processes [shape=diamond, style="filled", fillcolor="#fff3cd", peripheries=1, label=<<FONT POINT-SIZE="13">Reste-t-il une opération dont on<BR/>doit vérifier les besoins ?</FONT><BR/><FONT POINT-SIZE="10.5">for proc in processes.values()</FONT>>];
needs [shape=diamond, style="filled", fillcolor="#fff3cd", peripheries=1, label=<<FONT POINT-SIZE="13">Reste-t-il une ressource nécessaire<BR/>à cette opération ?</FONT><BR/><FONT POINT-SIZE="10.5">for res in proc.needs</FONT>>];
D46 [shape=diamond, style="filled", fillcolor="#fff3cd", peripheries=1, label=<<FONT POINT-SIZE="13">D46 · Cette ressource est-elle<BR/>absente des stocks déclarés et de<BR/>tous les résultats ?</FONT><BR/><FONT POINT-SIZE="10.5">res not in defined</FONT>>];
end [shape=ellipse, style="filled", fillcolor="#e2f2e7", peripheries=1, label=<<FONT POINT-SIZE="13">Ressources définies ; revenir dans G10</FONT>>];
error [shape=ellipse, style="filled", fillcolor="#fbe7e2", peripheries=1, label=<<FONT POINT-SIZE="13">Refuser : ressource sans source connue</FONT><BR/><FONT POINT-SIZE="10.5">ParseError(&quot;unknown resource …&quot;) → G02</FONT>>];
start -> init [label=""];
init -> producers [label=""];
producers -> gather [label="Oui"];
producers -> processes [label="Non"];
gather -> producers [xlabel="Opération suivante", constraint=false, tailport=w, headport=w];
processes -> needs [label="Oui"];
processes -> end [label="Non"];
needs -> D46 [label="Oui"];
needs -> processes [xlabel="Non", constraint=false, tailport=w, headport=w];
D46 -> error [label="Oui"];
D46 -> needs [xlabel="Non", constraint=false, tailport=w, headport=w];
}