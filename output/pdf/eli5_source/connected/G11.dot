digraph flow {
graph [rankdir=TB, ranksep=0.28, nodesep=0.25, pad=0.12, splines=polyline, bgcolor="transparent", ordering=out];
node [fontname="Inter", fontsize=13, color="#66869b", fontcolor="#172e43", penwidth=1.1, margin="0.13,0.09"];
edge [fontname="Inter", fontsize=11, color="#486d84", fontcolor="#235d6d", penwidth=1.15, arrowsize=0.7];
start [shape=ellipse, style="filled", fillcolor="#e2f2e7", peripheries=1, label=<<FONT POINT-SIZE="13">Tous les départs ont été acceptés</FONT>>];
complete [shape=box, style="filled,rounded", fillcolor="#e3f1f3", peripheries=2, label=<<FONT POINT-SIZE="13">Ajouter les résultats des fins jusqu’au<BR/>seuil final<BR/>Détail : G09</FONT><BR/><FONT POINT-SIZE="10.5">completion = _update_stock_from_finished_jobs(2**63 - 1,<BR/>state.running, state.stocks)</FONT>>];
last [shape=box, style="filled,rounded", fillcolor="#edf4fa", peripheries=1, label=<<FONT POINT-SIZE="13">Conserver le plus grand moment atteint</FONT><BR/><FONT POINT-SIZE="10.5">state.last_cycle = max(state.last_cycle,<BR/>completion)</FONT>>];
construct [shape=box, style="filled,rounded", fillcolor="#e3f1f3", peripheries=2, label=<<FONT POINT-SIZE="13">Créer l’objet qui portera le résultat<BR/>Détail : G24</FONT><BR/><FONT POINT-SIZE="10.5">sim = Simulator(config)</FONT>>];
replace [shape=box, style="filled,rounded", fillcolor="#edf4fa", peripheries=1, label=<<FONT POINT-SIZE="13">Placer les stocks et le temps vérifiés<BR/>dans cet objet</FONT><BR/><FONT POINT-SIZE="10.5">sim.stocks = state.stocks<BR/>sim.time = sim._max_time = state.last_cycle</FONT>>];
end [shape=ellipse, style="filled", fillcolor="#e2f2e7", peripheries=1, label=<<FONT POINT-SIZE="13">Renvoyer cet état à G06</FONT><BR/><FONT POINT-SIZE="10.5">return sim</FONT>>];
start -> complete [label=""];
complete -> last [label=""];
last -> construct [label=""];
construct -> replace [label=""];
replace -> end [label=""];
}